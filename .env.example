# Golden Gab — clés des fournisseurs d'assets externes (photos, b-roll).
# Au moins une des deux ; le script bascule automatiquement de l'une à l'autre.
# Ne jamais committer ce fichier : copier en `.env` et renseigner la valeur.

# Pexels — clé gratuite : https://www.pexels.com/api/
PEXELS_API_KEY=

# Pixabay — clé gratuite : https://pixabay.com/api/docs/ (s'affiche après connexion)
PIXABAY_API_KEY=

# Gemini (Google AI Studio) — génération de candidats de poses de la mascotte.
# Clé : https://aistudio.google.com/apikey — workflow : docs/MASCOT-POSES.md
# ⚠️ Les modèles image (Nano Banana) ne sont PAS dans le palier gratuit :
#    sans facturation active, scripts/generate-mascot-pose.mjs écrit un brief
#    à coller dans Google AI Studio au lieu d'appeler l'API.
GEMINI_API_KEY=

# Modèle image utilisé par scripts/generate-mascot-pose.mjs.
# Vide = valeur par défaut du script : gemini-nano-banana-2.1
# (autres valeurs : gemini-3.1-flash-lite-image, gemini-3-pro-image)
GEMINI_IMAGE_MODEL=
